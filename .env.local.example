# Google service account (lihat SETUP.md untuk cara membuatnya)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX...\n-----END PRIVATE KEY-----\n"

# ID Google Spreadsheet (dari URL: docs.google.com/spreadsheets/d/<INI>/edit)
GOOGLE_SHEET_ID=

# ID Shared Drive (atau subfolder di dalamnya) tujuan upload foto — HARUS Shared
# Drive, bukan folder biasa di My Drive, karena service account tidak punya kuota
# penyimpanan sendiri. ID Shared Drive selalu diawali "0A".
# Diambil dari URL: drive.google.com/drive/folders/<INI>
GOOGLE_DRIVE_FOLDER_ID=

# String acak panjang untuk menandatangani session admin (boleh generate dengan: openssl rand -base64 32)
SESSION_SECRET=

# Kredensial admin pertama, dipakai sekali saat memanggil POST /api/setup
ADMIN_EMAIL=admin@archipelagohotels.com
ADMIN_PASSWORD=ganti-dengan-password-kuat
